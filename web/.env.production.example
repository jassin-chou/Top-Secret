# 部署到 Vercel 時不用這個檔案：這些值請填在 Vercel 專案的 Environment Variables（見 DEPLOY.md）。
# 只有想在本機用 Firebase 正式專案建置前端時，才複製成 web/.env.production 使用。
VITE_BACKEND=firebase
VITE_API_BASE=/api
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<專案ID>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<專案ID>
VITE_FIREBASE_APP_ID=
